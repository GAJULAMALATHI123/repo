{
  "_version": "1.65.0",
  "sap.app": {
    "id": "itam.assets",
    "type": "application",
    "title": "IT Asset Lifecycle Manager",
    "description": "Asset inventory and lifecycle management",
    "applicationVersion": { "version": "0.1.0" },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/user/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0",
          "annotations": ["localAnnotations", "maintenanceAnnotations"]
        }
      },
      "localAnnotations": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotations.xml",
        "settings": { "localUri": "annotations/annotations.xml" }
      },
      "maintenanceAnnotations": {
        "type": "ODataAnnotation",
        "uri": "annotations/maintenance-requests.xml",
        "settings": { "localUri": "annotations/maintenance-requests.xml" }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": { "icon": "sap-icon://laptop" },
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.fe.templates": {},
        "sap.fe.core": {},
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "itam.assets.i18n.i18n" }
      }
    },
    "routing": {
      "routes": [
        { "pattern": ":?query:", "name": "AssetsList", "target": "AssetsList" },
        { "pattern": "Assets({key}):?query:", "name": "AssetsObjectPage", "target": "AssetsObjectPage" },
        { "pattern": "MaintenanceRequests:?query:", "name": "MaintenanceRequestsList", "target": "MaintenanceRequestsList" }
      ],
      "targets": {
        "AssetsList": {
          "type": "Component",
          "id": "AssetsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "Assets",
              "variantManagement": "Page",
              "navigation": { "Assets": { "detail": { "route": "AssetsObjectPage" } } },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": { "type": "ResponsiveTable" }
                }
              }
            }
          }
        },
        "AssetsObjectPage": {
          "type": "Component",
          "id": "AssetsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": { "settings": { "entitySet": "Assets" } }
        },
        "MaintenanceRequestsList": {
          "type": "Component",
          "id": "MaintenanceRequestsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "MaintenanceRequests",
              "variantManagement": "Page",
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": { "type": "ResponsiveTable" }
                }
              }
            }
          }
        }
      }
    }
  }
}
