{
  "welcomeFile": "/login.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/fiori/admin/(.*)$",
      "target": "/fiori/admin/$1",
      "localDir": "resources",
      "authenticationType": "xsuaa",
      "scope": [
        "$XSAPPNAME.Admin"
      ]
    },
    {
      "source": "^/fiori/manager/(.*)$",
      "target": "/fiori/manager/$1",
      "localDir": "resources",
      "authenticationType": "xsuaa",
      "scope": [
        "$XSAPPNAME.Manager"
      ]
    },
    {
      "source": "^/fiori/user/(.*)$",
      "target": "/fiori/user/$1",
      "localDir": "resources",
      "authenticationType": "xsuaa",
      "scope": [
        "$XSAPPNAME.User"
      ]
    },
    {
      "source": "^/admin/(.*)$",
      "target": "/admin/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "scope": [
        "$XSAPPNAME.Admin"
      ],
      "forwardAuthToken": true
    },
    {
      "source": "^/manager/(.*)$",
      "target": "/manager/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "scope": [
        "$XSAPPNAME.Manager"
      ],
      "forwardAuthToken": true
    },
    {
      "source": "^/user/(.*)$",
      "target": "/user/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "scope": [
        "$XSAPPNAME.User"
      ],
      "forwardAuthToken": true
    },
    {
      "source": "^/admin\\.html$",
      "target": "/admin.html",
      "localDir": "resources",
      "authenticationType": "xsuaa",
      "scope": [
        "$XSAPPNAME.Admin"
      ]
    },
    {
      "source": "^/manager\\.html$",
      "target": "/manager.html",
      "localDir": "resources",
      "authenticationType": "xsuaa",
      "scope": [
        "$XSAPPNAME.Manager"
      ]
    },
    {
      "source": "^/index\\.html$",
      "target": "/index.html",
      "localDir": "resources",
      "authenticationType": "xsuaa",
      "scope": [
        "$XSAPPNAME.User"
      ]
    },
    {
      "source": "^/(.*\\.(?:css|js))$",
      "target": "/$1",
      "localDir": "resources",
      "authenticationType": "none"
    },
    {
      "source": "^/signed-out\\.html$",
      "target": "/signed-out.html",
      "localDir": "resources",
      "authenticationType": "none"
    },
    {
      "source": "^/login\\.html$",
      "target": "/login.html",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/$",
      "target": "/login.html",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    }
  ],
  "logout": {
    "logoutEndpoint": "/logout",
    "logoutPage": "/signed-out.html"
  }
}
