{
  "_version": "1.65.0",
  "sap.app": {
    "id": "itam.fiori.user",
    "type": "application",
    "title": "IT Asset Lifecycle Manager — User",
    "description": "SAP Fiori elements application for IT Asset Lifecycle Manager",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "userService": {
        "uri": "/user/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.f": {},
        "sap.fe.core": {}
      }
    },
    "models": {
      "": {
        "dataSource": "userService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true,
          "synchronizationMode": "None"
        }
      }
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": "",
          "name": "Home",
          "target": "Assets"
        },
        {
          "pattern": "Assets({key}):?query:",
          "name": "AssetsObjectPage",
          "target": "AssetsObjectPage"
        },
        {
          "pattern": "assets",
          "name": "Assets",
          "target": "Assets"
        },
        {
          "pattern": "Assets({key}):?query:",
          "name": "AssetsObjectPage",
          "target": "AssetsObjectPage"
        },
        {
          "pattern": "requests",
          "name": "MaintenanceRequests",
          "target": "MaintenanceRequests"
        },
        {
          "pattern": "MaintenanceRequests({key}):?query:",
          "name": "MaintenanceRequestsObjectPage",
          "target": "MaintenanceRequestsObjectPage"
        }
      ],
      "targets": {
        "Assets": {
          "type": "Component",
          "id": "Assets",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Assets",
              "variantManagement": "Page",
              "navigation": {
                "Assets": {
                  "detail": {
                    "route": "AssetsObjectPage"
                  }
                }
              }
            }
          }
        },
        "MaintenanceRequests": {
          "type": "Component",
          "id": "MaintenanceRequests",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/MaintenanceRequests",
              "variantManagement": "Page",
              "navigation": {
                "MaintenanceRequests": {
                  "detail": {
                    "route": "MaintenanceRequestsObjectPage"
                  }
                }
              }
            }
          }
        },
        "AssetsObjectPage": {
          "type": "Component",
          "id": "AssetsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Assets"
            }
          }
        },
        "MaintenanceRequestsObjectPage": {
          "type": "Component",
          "id": "MaintenanceRequestsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/MaintenanceRequests"
            }
          }
        }
      }
    }
  }
}
